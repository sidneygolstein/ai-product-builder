{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "bash \"$HOME/.claude/plugins/ai-product-builder/hooks/session-start.sh\"" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash \"$HOME/.claude/plugins/ai-product-builder/hooks/destructive-guard.sh\"" }]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{ "type": "command", "command": "bash \"$HOME/.claude/plugins/ai-product-builder/hooks/post-tool-format.sh\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "bash \"$HOME/.claude/plugins/ai-product-builder/hooks/baseline-stop.sh\"" }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{ "type": "command", "command": "bash \"$HOME/.claude/plugins/ai-product-builder/hooks/baseline-stop.sh\"" }]
      }
    ]
  }
}
